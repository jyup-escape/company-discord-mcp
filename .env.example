# Local development. For company use, set an HTTPS origin (no /mcp suffix).
PUBLIC_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000

# One Discord application and one Bot for the whole company.
DISCORD_CLIENT_ID=replace_with_application_id
DISCORD_CLIENT_SECRET=replace_with_oauth_client_secret
DISCORD_BOT_TOKEN=replace_with_bot_token
DISCORD_GUILD_ID=replace_with_company_server_id

# Any one of these roles qualifies. Empty = every non-bot member of the server.
EMPLOYEE_ROLE_IDS=
# Optional channel allowlist; empty = all supported channels allowed by Discord permissions.
ALLOWED_CHANNEL_IDS=
ENABLE_SEND=true

DATABASE_PATH=./data/company-discord.db
# Generated by npm run setup. Keep this key for the lifetime of the database.
DATABASE_KEY=GENERATE_WITH_SETUP

# Exact HTTPS callback URLs; native HTTP loopback callbacks are supported separately.
OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
# Comma-separated browser origins allowed to call /mcp directly (usually unnecessary for native/server clients).
ALLOWED_ORIGINS=
# Exact trusted reverse proxy IPs/CIDRs only. HTTPS Compose sets this automatically.
TRUST_PROXY=

# Used only by compose.https.yaml and Caddyfile.
MCP_DOMAIN=mcp.example.com
