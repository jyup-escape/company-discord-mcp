{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "company-discord-mcp",
  "main": "workers/index.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_server_modules"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "COMPANY",
        "class_name": "CompanyDiscord"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CompanyDiscord"
      ]
    }
  ],
  "vars": {
    "PUBLIC_URL": "https://company-discord-mcp.desudesu2387.workers.dev"
  },
  "observability": {
    "enabled": false
  }
}
